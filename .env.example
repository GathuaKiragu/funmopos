# Required server-side security configuration
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-random-32-plus-character-secret
CRON_SECRET=replace-with-a-random-cron-secret
PLATFORM_TIMEZONE=Africa/Nairobi

# AI analysis is optional. Without this key, statistical predictions remain available
# and deep analysis is recorded as unavailable.
GEMINI_API_KEY=
AI_ANALYSIS_MODEL=gemini-2.5-flash
AI_DAILY_REQUEST_BUDGET=40
PAYSTACK_SECRET_KEY=
# Configure this URL in Paystack Dashboard → Webhooks after deployment:
# https://your-domain.example/api/webhooks/paystack

# Firebase Admin credentials (server only)
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
